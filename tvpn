#!/usr/bin/env bash
# tvpn — T-VPN の SOCKS5 プロキシ（tvpn-proxy コンテナ）を Linux（WSL）だけで手動起動・停止する。
#
#   ./tvpn up       認証情報を読み、コンテナを build・起動して、VPN と SOCKS5 がつながるまで待つ
#   ./tvpn down     コンテナを止めて消す（VPN を切る）
#   ./tvpn status   コンテナの状態と ppp0 のアドレス
#   ./tvpn logs     ログを追う
#
# 認証情報: .env があればそれを使う。無ければ arc-env（Bitwarden Secrets Manager）の
# TVPN_UID / TVPN_SECRET_PATTERN / TVPN_STATIC_PASS / TVPN_PSK を V_UID / V_PATTERN / V_STATIC / VPN_PSK に渡す。
# 値はファイルに書かず、表示もしない。
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"

CONNECT_TIMEOUT=${TVPN_CONNECT_TIMEOUT:-180}

load_credentials() {
  [ -f .env ] && return 0
  local exports
  exports=$(arc-env) || { echo "tvpn: arc-env が失敗した（bws-unlock を実行してから再試行）" >&2; exit 1; }
  eval "$exports"
  export V_UID="${TVPN_UID:?TVPN_UID がない}"
  export V_PATTERN="${TVPN_SECRET_PATTERN:?TVPN_SECRET_PATTERN がない}"
  export V_STATIC="${TVPN_STATIC_PASS:?TVPN_STATIC_PASS がない}"
  export VPN_PSK="${TVPN_PSK:?TVPN_PSK がない}"
}

status() {
  docker compose ps
  docker exec tvpn-proxy ip -4 -br addr show ppp0 2>/dev/null || echo "ppp0: なし（未接続）"
}

wait_connected() {
  local deadline=$((SECONDS + CONNECT_TIMEOUT)) logs
  while ((SECONDS < deadline)); do
    logs=$(docker compose logs --no-color tvpn-proxy 2>&1)
    if grep -q 'SOCKS5 proxy server started' <<<"$logs"; then
      echo "tvpn: 接続した（SOCKS5: 127.0.0.1:1080）"
      return 0
    fi
    if grep -q -E '\[(ERROR|FATAL)\]' <<<"$logs"; then
      grep -E '\[(INFO|WARN|ERROR|FATAL)\]' <<<"$logs" | tail -n 20 >&2
      echo "tvpn: 接続に失敗した。詳細は ./tvpn logs、止めるには ./tvpn down" >&2
      return 1
    fi
    sleep 3
  done
  echo "tvpn: ${CONNECT_TIMEOUT} 秒以内につながらなかった。詳細は ./tvpn logs、止めるには ./tvpn down" >&2
  return 1
}

case "${1:-}" in
  up)
    load_credentials
    docker compose up -d --build --force-recreate
    wait_connected
    status
    ;;
  down) docker compose down ;;
  status) status ;;
  logs) docker compose logs -f tvpn-proxy ;;
  *)
    sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
    ;;
esac
